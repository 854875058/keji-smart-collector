{
  "manifest_version": 3,
  "name": "可记 - 智能收藏助手",
  "version": "1.0.3",
  "description": "一键保存、整理和搜索来自 ChatGPT、Claude 和 Gemini 的高质量 AI 回答。",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "打开 可记",
    "default_icon": {
      "16": "app-icon-16.png",
      "32": "app-icon-16.png",
      "48": "app-icon-16.png",
      "128": "app-icon-16.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://* wss://*;"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "assets/content.js"
      ],
      "css": [
        "assets/content.css"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "打开可记侧边栏"
    },
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "保存当前页面到可记"
    },
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "保存选中内容到可记"
    }
  },
  "icons": {
    "16": "app-icon-16.png",
    "32": "app-icon-16.png",
    "48": "app-icon-16.png",
    "128": "app-icon-16.png"
  }
}
